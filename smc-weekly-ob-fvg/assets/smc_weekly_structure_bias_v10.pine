dailyBullObColor = input.color(color.new(color.lime, 88), "Daily Bullish OB fill")
dailyBullObBorder = input.color(color.new(color.lime, 20), "Daily Bullish OB border")
dailyBearObColor = input.color(color.new(color.rgb(255, 128, 128), 88), "Daily Bearish OB fill")
dailyBearObBorder = input.color(color.new(color.rgb(255, 128, 128), 25), "Daily Bearish OB border")
dailyBullFvgColor = input.color(color.new(color.yellow, 84), "Daily Bullish FVG fill")
dailyBullFvgBorder = input.color(color.new(color.yellow, 10), "Daily Bullish FVG border")
dailyBearFvgColor = input.color(color.new(color.rgb(255, 176, 176), 90), "Daily Bearish FVG fill")
dailyBearFvgBorder = input.color(color.new(color.rgb(255, 176, 176), 30), "Daily Bearish FVG border")
dailyMidlineColor = input.color(color.new(color.white, 25), "Daily zone midpoint color")
dailyObBosLineColor = input.color(color.new(color.red, 0), "Daily OB BOS structure line color")

const int maxHistoryWeeks = 520
const int maxHistoryDays = 4000
const int statsLookbackDays = 1825
const int dayMs = 24 * 60 * 60 * 1000
const int dailyAtrLength = 14
const float dailyObBodyAtrMultiplier = 1.0
const float dailyFvgBodyAtrMultiplier = 1.0
const float dailyFvgMinGapAtrMultiplier = 0.50
const int dailyFvgMinGapTicks = 2
const float tradeTp1R = 1.0
const float tradeTp2R = 2.0
const float tradeTp1ExitFraction = 0.50

var int lastCanonicalWeeklyTime = na
var int lastCanonicalDailyTime = na

var box[] dailyZoneBoxes = array.new_box()
var line[] dailyZoneMidlines = array.new_line()
var string[] dailyZoneTypes = array.new_string()
