dailyObSwingLen = input.int(4, "Daily OB swing length", minval=1, maxval=10)
showSetup = input.bool(true, "Show H1 SETUP")
showArmed = input.bool(true, "Show H1 ARMED")
armedSwingLen = input.int(3, "H1 ARMED swing length", minval=1, maxval=10)
