showWeeklyBiasLevels = input.bool(false, "Show Weekly Bias swing levels")
showWeeklyBiasMarkers = input.bool(true, "Show Weekly Bias flip markers")
showWeeklyBiasBackground = input.bool(true, "Show Weekly Bias background")
weeklyBiasSwingLen = input.int(2, "W Bias swing length", minval=1, maxval=10)

showDailyOb = input.bool(true, "Show Daily OB")
showDailyFvg = input.bool(true, "Show Daily FVG")
showDailyMidline = input.bool(false, "Show Daily zone midpoint")
