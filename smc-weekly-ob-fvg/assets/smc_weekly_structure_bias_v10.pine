var int fvgSlCount = 0
var float obNetR = 0.0
var float fvgNetR = 0.0
var float lastConfirmedH1ArmedPivotHigh = na
var int firstAvailableH1Time = na

var line[] tradeSlLines = array.new_line()
var line[] tradeTp1Lines = array.new_line()
var line[] tradeTp2Lines = array.new_line()
var label[] tradeLabels = array.new_label()
var string[] tradeZoneKeys = array.new_string()
var string[] tradeZoneTypes = array.new_string()
