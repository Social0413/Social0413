    cmpH4LastTouch := cmpH4TouchKey

    cmpH4ExpiryBars = math.max(1, int(math.ceil(setupExpiryHours * 3600.0 / 14400.0)))
    cmpH4SetupInvalid = cmpH4SetupDir != 0 and (cmpH4Step - cmpH4SetupStep > cmpH4ExpiryBars or setupBias != cmpH4SetupDir or not zoneIsActive(cmpH4SetupZone))
    if cmpH4SetupInvalid
        cmpH4SetupDir := 0
        cmpH4SetupStep := na
