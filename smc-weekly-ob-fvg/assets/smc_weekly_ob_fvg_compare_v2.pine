    cmpH4Displacement = armedBodyAtrMult == 0.0 or math.abs(cmpH4C - cmpH4O) >= cmpH4ATR * armedBodyAtrMult
    cmpH4BullArmed = cmpH4SetupDir == 1 and cmpH4Step > cmpH4SetupStep and not na(cmpH4Break) and not na(cmpH4PrevC) and cmpH4C > cmpH4Break and cmpH4PrevC <= cmpH4Break and cmpH4Displacement
    cmpH4BearArmed = cmpH4SetupDir == -1 and cmpH4Step > cmpH4SetupStep and not na(cmpH4Break) and not na(cmpH4PrevC) and cmpH4C < cmpH4Break and cmpH4PrevC >= cmpH4Break and cmpH4Displacement
    if cmpH4BullArmed or cmpH4BearArmed
        cmpH4Armed += 1
        cmpH4ArmedDir := cmpH4SetupDir
        cmpH4ArmedStep := cmpH4Step
        cmpH4ArmedZone := cmpH4SetupZone
        cmpH4Retest := cmpH4Break
        cmpH4Protect := cmpH4SetupDir == 1 ? cmpH4LastPL : cmpH4LastPH
        cmpH4SetupDir := 0
        cmpH4SetupStep := na
        cmpH4SetupZone := ""
        cmpH4Break := na

    cmpH4EntryInvalid = cmpH4ArmedDir != 0 and ((entryExpiryBars > 0 and cmpH4Step - cmpH4ArmedStep > entryExpiryBars) or setupBias != cmpH4ArmedDir or not zoneIsActive(cmpH4ArmedZone) or (cmpH4ArmedDir == 1 ? (not na(cmpH4Protect) and cmpH4C < cmpH4Protect) : (not na(cmpH4Protect) and cmpH4C > cmpH4Protect)))
    if cmpH4EntryInvalid
        cmpH4ArmedDir := 0
        cmpH4ArmedStep := na
        cmpH4ArmedZone := ""
        cmpH4Retest := na
        cmpH4Protect := na

    cmpH4Entry = cmpH4ArmedDir == 1 ? (cmpH4Step > cmpH4ArmedStep and cmpH4L <= cmpH4Retest and cmpH4C > cmpH4Retest) : cmpH4ArmedDir == -1 ? (cmpH4Step > cmpH4ArmedStep and cmpH4H >= cmpH4Retest and cmpH4C < cmpH4Retest) : false
    if cmpH4Entry
        if compareAddTrade(cmpH4ArmedDir, cmpH4C, cmpH4Protect, cmpH4Step, cmpH4TradeDirs, cmpH4TradeEntries, cmpH4TradeStops, cmpH4TradeTp1s, cmpH4TradeTp2s, cmpH4TradeStarts, cmpH4TradeStatuses)
            cmpH4Total += 1
        cmpH4ArmedDir := 0
        cmpH4ArmedStep := na
        cmpH4ArmedZone := ""
        cmpH4Retest := na
        cmpH4Protect := na

    [cmpH4DW, cmpH4DTL, cmpH4DDL, cmpH4DGW, cmpH4DGL, cmpH4DNet] = compareUpdateTrades(cmpH4H, cmpH4L, cmpH4Step, cmpH4TradeDirs, cmpH4TradeEntries, cmpH4TradeStops, cmpH4TradeTp1s, cmpH4TradeTp2s, cmpH4TradeStarts, cmpH4TradeStatuses)
    cmpH4Wins += cmpH4DW
    cmpH4Tp1Losses += cmpH4DTL
    cmpH4DirectLosses += cmpH4DDL
    cmpH4GrossWin += cmpH4DGW
    cmpH4GrossLoss += cmpH4DGL
    cmpH4Net += cmpH4DNet
    cmpH4PrevC := cmpH4C

var table compareTable = table.new(position.bottom_right, 9, 5, bgcolor=color.new(color.black, 10), frame_color=color.new(color.gray, 45), frame_width=1)

compareCell(_col, _row, _text, _color) =>
    table.cell(compareTable, _col, _row, _text, text_color=_color)

compareRow(_row, _name, _setups, _armed, _total, _wins, _tp1Losses, _directLosses, _grossWin, _grossLoss, _net) =>
    _closed = _wins + _tp1Losses + _directLosses
    _tp1Rate = _closed > 0 ? (_wins + _tp1Losses) * 100.0 / _closed : na
    _tp2Rate = _closed > 0 ? _wins * 100.0 / _closed : na
    _avg = _closed > 0 ? _net / _closed : na
    _pf = _grossLoss > 0.0 ? _grossWin / _grossLoss : na
    compareCell(0, _row, _name, color.white)
    compareCell(1, _row, str.tostring(_setups), color.white)
    compareCell(2, _row, str.tostring(_armed), color.white)
    compareCell(3, _row, str.tostring(_total), color.white)
    compareCell(4, _row, na(_tp1Rate) ? "—" : str.tostring(_tp1Rate, "#.0") + "%", color.white)
    compareCell(5, _row, na(_tp2Rate) ? "—" : str.tostring(_tp2Rate, "#.0") + "%", color.white)
    compareCell(6, _row, str.tostring(_net, "#.##") + "R", _net >= 0 ? color.lime : color.red)
    compareCell(7, _row, na(_avg) ? "—" : str.tostring(_avg, "#.##") + "R", color.white)
    compareCell(8, _row, na(_pf) ? "—" : str.tostring(_pf, "#.##"), color.white)

if barstate.islast
    table.clear(compareTable, 0, 0, 8, 4)
    table.cell(compareTable, 0, 0, compareChartOk ? "AUTO COMPARE" : "USE M30 CHART", text_color=color.white, bgcolor=compareChartOk ? color.new(color.navy, 10) : color.new(color.orange, 10))
    compareCell(1, 0, "SETUP", color.silver)
    compareCell(2, 0, "ARMED", color.silver)
    compareCell(3, 0, "TRADES", color.silver)
    compareCell(4, 0, "TP1%", color.silver)
    compareCell(5, 0, "TP2%", color.silver)
    compareCell(6, 0, "NET R", color.silver)
    compareCell(7, 0, "AVG R", color.silver)
    compareCell(8, 0, "PF", color.silver)
    if compareChartOk
        compareRow(1, "H4", cmpH4Setups, cmpH4Armed, cmpH4Total, cmpH4Wins, cmpH4Tp1Losses, cmpH4DirectLosses, cmpH4GrossWin, cmpH4GrossLoss, cmpH4Net)
        compareRow(2, "H1", cmpH1Setups, cmpH1Armed, cmpH1Total, cmpH1Wins, cmpH1Tp1Losses, cmpH1DirectLosses, cmpH1GrossWin, cmpH1GrossLoss, cmpH1Net)
        compareRow(3, "M30", cmpM30Setups, cmpM30Armed, cmpM30Total, cmpM30Wins, cmpM30Tp1Losses, cmpM30DirectLosses, cmpM30GrossWin, cmpM30GrossLoss, cmpM30Net)
        table.cell(compareTable, 0, 4, "Window", text_color=color.silver)
        table.cell(compareTable, 1, 4, str.tostring(statsLookbackDays) + "D", text_color=color.white)
        table.cell(compareTable, 2, 4, "Expiry", text_color=color.silver)
        table.cell(compareTable, 3, 4, str.tostring(setupExpiryHours) + "H", text_color=color.white)
        table.cell(compareTable, 4, 4, "SL first", text_color=color.silver)
    for compareCol = 0 to 8
        for compareRowIndex = 0 to 4
            table.cell_set_text_size(compareTable, compareCol, compareRowIndex, size.tiny)
